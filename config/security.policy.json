{
  "write_authority": "HAIKU",
  "blocked_patterns": [
    "rm -rf",
    "sudo",
    "mkfs",
    "dd if=",
    "chmod -R",
    "chown -R",
    "curl .*\\|.*sh",
    "wget .*\\|.*sh",
    "--no-sandbox",
    "git push --force",
    "git reset --hard",
    "git clean -fdx",
    "/etc/",
    "~/.ssh",
    "/proc/",
    "/sys/",
    "/dev/"
  ],
  "persona_write_policy": {
    "SONNET": false,
    "OPUS": false,
    "MYTHOS": false,
    "HAIKU": true
  }
}
