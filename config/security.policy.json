{
  "default": "deny_unknown_mutation",
  "blocked_patterns": [
    "rm -rf",
    "sudo",
    "mkfs",
    "dd if=",
    "chmod -R",
    "chown -R",
    "curl .*\\|.*sh",
    "wget .*\\|.*sh",
    "--no-sandbox",
    "git push --force",
    "git reset --hard",
    "git clean -fdx",
    "/etc/",
    "~/.ssh",
    "/proc/",
    "/sys/",
    "/dev/"
  ],
  "allowed_tools": [
    "read_file",
    "list_files",
    "grep_search",
    "git_snapshot",
    "run_v8_build",
    "run_v8_test",
    "propose_patch",
    "atomic_write",
    "rollback",
    "failure_graph",
    "log_evidence"
  ],
  "write_allowed_persona": "HAIKU"
}
