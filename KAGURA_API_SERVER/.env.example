NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Required for Gemini API.
GEMINI_API_KEY=replace_me

# Production default. Override only when you intentionally pin another Flash model.
GEMINI_FLASH_MODEL=gemini-2.5-flash
HOMURA_SEARCH_MODEL=gemini-2.5-flash

# HOMURA search provider:
# google_search uses Gemini built-in Google Search grounding.
# external_http forwards search to GENIE_API_URL if you have a separate Genie endpoint.
HOMURA_SEARCH_PROVIDER=google_search
GENIE_API_URL=
GENIE_API_KEY=

KAGURA_EVIDENCE_DIR=./data/evidence
KAGURA_MAX_INPUT_CHARS=24000
KAGURA_MAX_CONTEXT_CHARS=48000
KAGURA_MAX_OUTPUT_TOKENS=4096
KAGURA_TEMPERATURE=0.2

# Comma-separated origins. Use * only behind a trusted reverse proxy.
CORS_ORIGINS=*
