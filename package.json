{
  "name": "kagrra-complete-dev-package",
  "version": "1.0.0",
  "description": "KAGRRA complete Gemini API runtime package for V8 workspace",
  "type": "module",
  "main": "dist/src/cli.js",
  "bin": {
    "kagrra": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "doctor": "tsx src/cli.ts doctor",
    "dashboard": "tsx src/cli.ts dashboard",
    "test": "tsx tests/run-tests.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
